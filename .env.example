# Para deploy en Netlify: copia este archivo como .env en tu máquina local
# y reemplaza los valores. Las mismas variables deben ir en Netlify.

# === Base de datos (Neon Postgres) ===
# Crea tu DB en https://neon.tech → New Project → Connection string
# Formato: postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# === NextAuth ===
# Genera un secret seguro con: openssl rand -base64 32
NEXTAUTH_SECRET="REEMPLAZA_CON_UN_SECRET_DE_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"
